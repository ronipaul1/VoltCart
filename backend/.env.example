# ============================================================
# VOLTCART ECOMMERCE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your test/live credentials
# NEVER commit the real .env file with private keys
# ============================================================

# Environment & Server
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=voltcart_ecommerce

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_also_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Frontend CORS
FRONTEND_URL=http://localhost:3000

# Payment Gateway — Razorpay
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Transactional Email Provider — Brevo (Sendinblue)
# If BREVO_API_KEY is not set or left as placeholder, backend runs in safe Simulation Mode
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM_NAME=VoltCart
EMAIL_FROM_ADDRESS=support@voltcart.com
ADMIN_EMAIL=admin@voltcart.com

# Shipping Provider — Shippo
SHIPPO_API_TOKEN=shippo_test_yourTokenHere
SHIPPO_TOKEN=shippo_test_yourTokenHere
SHIPPO_API_VERSION=2018-02-08
SHIPPO_LABEL_FILE_TYPE=PDF_4x6

# Store Origin & Warehouse Details (Configurable in Admin Panel -> Settings -> Shipping Origin)
STORE_NAME=VoltCart
STORE_EMAIL=support@voltcart.com
STORE_PHONE=+91 80 4567 8900
STORE_ADDRESS=108 Tech Park Boulevard, Electronic City
STORE_CITY=Bengaluru
STORE_STATE=Karnataka
STORE_POSTAL_CODE=560100
STORE_COUNTRY=IN

# Default Shipping Parcel Parameters
SHIPPO_PARCEL_LENGTH_CM=30
SHIPPO_PARCEL_WIDTH_CM=20
SHIPPO_PARCEL_HEIGHT_CM=15
SHIPPO_DEFAULT_ITEM_WEIGHT_KG=0.5
SHIPPO_MIN_WEIGHT_KG=0.10
SHIPPO_DISTANCE_UNIT=cm
SHIPPO_MASS_UNIT=kg

# Origin address aliases for Shippo API
SHIPPO_FROM_NAME=VoltCart Central Fulfillment
SHIPPO_FROM_COMPANY=VoltCart Technologies Pvt Ltd
SHIPPO_FROM_STREET1=108 Tech Park Boulevard, Electronic City
SHIPPO_FROM_STREET2=Phase 1, Warehouse Unit 4
SHIPPO_FROM_CITY=Bengaluru
SHIPPO_FROM_STATE=Karnataka
SHIPPO_FROM_ZIP=560100
SHIPPO_FROM_COUNTRY=IN
SHIPPO_FROM_PHONE=+91 80 4567 8900
SHIPPO_FROM_EMAIL=dispatch@voltcart.com
SHIPPO_FROM_IS_RESIDENTIAL=false

# File Uploads & Security
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
